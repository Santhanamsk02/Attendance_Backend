# Supabase PostgreSQL Connection String Example:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
# For local SQLite fallback during development:
DATABASE_URL=sqlite:///./attendance.db

# API & Security Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Student Attendance Management System"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
